{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio (python http.server)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000", "--directory", "portfolio"],
      "port": 8000
    },
    {
      "name": "portfolio (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "portfolio", "-l", "3000"],
      "port": 3000
    }
  ]
}
